<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} [%X{correlationId}] %msg%n</pattern></encoder>
    </appender>
    <logger name="com.gavel" level="WARN"/>
    <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
