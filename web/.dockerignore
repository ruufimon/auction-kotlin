# Docker build context exclusions
# Speeds up docker build by excluding unnecessary files

# Version control
.git
.gitignore
.gitmodules

# Dependencies (rebuilt in container)
node_modules
npm-debug.log
npm-error.log
yarn-error.log
pnpm-debug.log
.pnpm-store

# Build outputs (rebuilt in container)
dist
build
.next
.vinext
.nuxt
.cache

# IDE and editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Environment
.env
.env.local
.env.*.local

# Testing
coverage
.nyc_output
*.lcov

# Documentation
README.md
CHANGELOG.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.circleci/
.travis.yml

# Misc
*.log
logs/
temp/
tmp/
.wrangler/

# Cloudflare specific
.wrangler/
.vinext/

# TypeScript
tsconfig.tsbuildinfo

# OS
Thumbs.db
.DS_Store
