# Local development settings. Copy to .env and export, e.g. `set -a; . ./.env; set +a`.
# These values are for local use only; production secrets live in App Platform.
DATABASE_URL=postgresql://gavel:gavel@localhost:5432/gavel
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
PAYMENT_WEBHOOK_SECRET=local-dev-webhook-secret
WEB_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SEED_DEMO_DATA=true
# Logs verification links instead of emailing them (local only; requires COOKIE_SECURE=false).
DEV_EMAIL_LINKS=true
# Optional:
# ADMIN_TOKEN=<32+ random characters>     enables /admin/v1 operator endpoints
# METRICS_TOKEN=<16+ random characters>   enables GET /metrics (Prometheus)
# CURRENCY=USD
# MIN_BID_INCREMENT_MINOR=100
# PAYMENT_WINDOW_HOURS=24
